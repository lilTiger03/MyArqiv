# Public catalogue backend. Usually discovered automatically from Expo on a phone.
# On a physical phone use your computer's LAN address, not localhost.
# EXPO_PUBLIC_API_URL=http://192.168.1.10:4000

# Public Supabase client settings. Never put a secret or service_role key here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
